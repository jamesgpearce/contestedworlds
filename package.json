{
  "name": "contested-worlds",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:check": "node scripts/build-data.mjs --check",
    "data:build": "node scripts/build-data.mjs",
    "predev": "npm run data:build",
    "prebuild": "npm run data:build",
    "test": "npm run data:build && vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "postbuild": "node scripts/prepare-static.mjs",
    "check:export": "node scripts/check-export.mjs",
    "social:build": "npm run data:build && node scripts/social-assets.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesgpearce/contestedworlds.git"
  }
}
