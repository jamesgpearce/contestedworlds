{
  "name": "contested-worlds",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "lint": "oxlint app lib components",
    "format": "oxfmt",
    "data:check": "python3 scripts/build-data.py --check",
    "data:build": "python3 scripts/build-data.py",
    "predev": "npm run data:build",
    "prebuild": "npm run data:build",
    "test": "npm run data:build && python3 -m unittest discover -s tests -p \"*_test.py\" && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --outDir dist/client --host 127.0.0.1 --port 3000",
    "postbuild": "node scripts/prepare-static.mjs",
    "check:export": "node scripts/check-export.mjs",
    "social:build": "npm run data:build && node scripts/social-assets.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "sharp": "0.35.4"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesgpearce/contestedworlds.git"
  }
}
